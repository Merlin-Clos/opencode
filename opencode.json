{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "instructions": [
    "~/.config/opencode/instructions/*.md"
  ],
  "subagent_depth": 2,
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "server": {
    "hostname": "0.0.0.0",
    "port": 4096
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "nuxt": {
      "type": "remote",
      "url": "https://nuxt.com/mcp",
      "enabled": false
    },
    "nuxt-ui": {
      "type": "remote",
      "url": "https://ui.nuxt.com/mcp",
      "enabled": false
    },
    "mempalace": {
      "type": "local",
      "command": [
        "/home/sten/.local/bin/mempalace-mcp"
      ],
      "enabled": false
    }
  }
}
